{
  "name": "dsh-approval-toast",
  "version": "0.7.12",
  "private": false,
  "type": "module",
  "description": "Merged DSH plugin: an approval ledger (records every approval with risk/decision/outcome, gate and auto modes, audit dashboard) plus bottom-right desktop toasts for task and approval attention (Windows WPF / Linux GTK).",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4478sc/DSH_Monitor.git"
  },
  "homepage": "https://github.com/4478sc/DSH_Monitor#readme",
  "bugs": {
    "url": "https://github.com/4478sc/DSH_Monitor/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "approval",
    "approval-ledger",
    "audit",
    "notification",
    "toast",
    "desktop",
    "attention"
  ],
  "license": "MIT",
  "contributors": [
    "4478sc",
    "温州深鲸智能科技有限公司 (approval ledger)",
    "zjbc2000 (attention-plugins)",
    "YiMlT (dsh-notify-yimit)"
  ]
}
